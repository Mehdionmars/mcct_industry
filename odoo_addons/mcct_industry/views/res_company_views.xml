<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Onglet sur la fiche société standard -->
    <record id="view_company_form_mcct" model="ir.ui.view">
        <field name="name">res.company.form.mcct</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Chantiers &amp; mentions légales" name="mcct">
                    <group>
                        <group string="Mentions légales (Maroc)">
                            <field name="company_registry" string="ICE"/>
                            <field name="mcct_if"/>
                            <field name="mcct_rc"/>
                            <field name="mcct_patente"/>
                            <field name="mcct_cnss"/>
                        </group>
                        <group string="Retenue de garantie par défaut">
                            <field name="mcct_retention_rate"/>
                            <field name="mcct_retention_cap_rate"/>
                            <field name="mcct_retention_base"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Formulaire court ouvert depuis Chantiers > Configuration > Paramètres -->
    <record id="view_company_form_mcct_settings" model="ir.ui.view">
        <field name="name">res.company.form.mcct.settings</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Paramètres chantiers" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">Devise : <field name="currency_id" readonly="1" class="d-inline"/></div>
                    </div>
                    <group>
                        <group string="Mentions légales (Maroc)">
                            <field name="company_registry" string="ICE" placeholder="15 chiffres"/>
                            <field name="mcct_if"/>
                            <field name="mcct_rc"/>
                            <field name="mcct_patente"/>
                            <field name="mcct_cnss"/>
                        </group>
                        <group string="Retenue de garantie par défaut">
                            <field name="mcct_retention_rate"/>
                            <field name="mcct_retention_cap_rate"/>
                            <field name="mcct_retention_base"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Ces valeurs sont reprises sur chaque nouveau chantier et restent modifiables
                        chantier par chantier. Les mentions légales apparaissent en bas des factures
                        et des situations de travaux.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcct_settings" model="ir.actions.server">
        <field name="name">Paramètres chantiers</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = model.action_mcct_open_settings()</field>
    </record>

</odoo>
