<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_mcct" model="ir.ui.view">
        <field name="name">account.move.form.mcct</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mcct_record_vat_withholding" type="object"
                        string="Constater la TVA retenue à la source"
                        invisible="state != 'posted' or move_type != 'out_invoice' or not mcct_vat_withholding_amount or mcct_vat_withholding_move_id or payment_state in ('paid', 'in_payment', 'reversed')"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="not mcct_payment_delay_exceeded">
                    Délai de paiement supérieur à 120 jours : non conforme à la loi 69-21
                    (60 jours par défaut, 120 jours au maximum par accord entre les parties).
                </div>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="mcct_project_id" readonly="state != 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True}"/>
                <field name="mcct_situation_id" invisible="not mcct_situation_id"/>
                <field name="mcct_is_advance" invisible="not mcct_is_advance"/>
                <field name="mcct_payment_mode" invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="mcct_vat_withholding_move_id" invisible="not mcct_vat_withholding_move_id"/>
                <field name="mcct_payment_delay_exceeded" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="mcct_retention_amount" invisible="not mcct_retention_amount"/>
                <field name="mcct_vat_withholding_amount" invisible="not mcct_vat_withholding_amount"/>
                <field name="mcct_net_to_pay" invisible="not mcct_retention_amount and not mcct_vat_withholding_amount"
                       class="oe_subtotal_footer_separator"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_mcct" model="ir.ui.view">
        <field name="name">account.move.search.mcct</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mcct_project_id"/>
            </xpath>
            <xpath expr="//filter[@name='draft']" position="before">
                <filter name="mcct_site_invoices" string="Factures chantier" domain="[('mcct_project_id', '!=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//search" position="inside">
                <group>
                    <filter name="group_mcct_project" string="Chantier" context="{'group_by': 'mcct_project_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_mcct_invoices" model="ir.actions.act_window">
        <field name="name">Factures chantier</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('mcct_project_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_group_mcct_project': 1}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

</odoo>
