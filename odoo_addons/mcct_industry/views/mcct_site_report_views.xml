<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcct_site_report_form" model="ir.ui.view">
        <field name="name">mcct.site.report.form</field>
        <field name="model">mcct.site.report</field>
        <field name="arch" type="xml">
            <form string="Rapport de chantier">
                <header>
                    <button name="action_publish" string="Publier au client" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_unpublish" string="Retirer du portail" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rapport journalier"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phase"/>
                            <field name="weather"/>
                            <field name="workforce"/>
                            <field name="hours_worked" widget="float_time"/>
                            <field name="progress" widget="progressbar" options="{'editable': true}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Travaux réalisés" name="work_done">
                            <field name="work_done" placeholder="Montage des fermes, pose de 120 m² de bardage…"/>
                        </page>
                        <page string="Problèmes / réserves" name="issues">
                            <field name="issues"/>
                        </page>
                        <page string="Prévisions" name="next_steps">
                            <field name="next_steps"/>
                        </page>
                        <page string="Photos" name="photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mcct_site_report_list" model="ir.ui.view">
        <field name="name">mcct.site.report.list</field>
        <field name="model">mcct.site.report</field>
        <field name="arch" type="xml">
            <list string="Rapports de chantier" sample="1">
                <field name="date"/>
                <field name="project_id"/>
                <field name="name"/>
                <field name="weather" optional="show"/>
                <field name="workforce" sum="Total"/>
                <field name="hours_worked" widget="float_time" sum="Total" optional="hide"/>
                <field name="photo_count" string="Photos" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_mcct_site_report_kanban" model="ir.ui.view">
        <field name="name">mcct.site.report.kanban</field>
        <field name="model">mcct.site.report</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="date" class="fw-bold"/>
                            <field name="state" widget="badge" class="ms-auto"/>
                        </div>
                        <field name="project_id" class="text-muted"/>
                        <field name="name"/>
                        <footer>
                            <span><i class="fa fa-users" title="Effectif"/> <field name="workforce"/></span>
                            <span class="ms-2"><i class="fa fa-camera" title="Photos"/> <field name="photo_count"/></span>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mcct_site_report_calendar" model="ir.ui.view">
        <field name="name">mcct.site.report.calendar</field>
        <field name="model">mcct.site.report</field>
        <field name="arch" type="xml">
            <calendar string="Rapports de chantier" date_start="date" color="project_id" mode="month">
                <field name="project_id" filters="1"/>
                <field name="workforce"/>
            </calendar>
        </field>
    </record>

    <record id="view_mcct_site_report_search" model="ir.ui.view">
        <field name="name">mcct.site.report.search</field>
        <field name="model">mcct.site.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Publiés" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_project" string="Chantier" context="{'group_by': 'project_id'}"/>
                    <filter name="group_user" string="Rédacteur" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcct_site_report" model="ir.actions.act_window">
        <field name="name">Rapports de chantier</field>
        <field name="res_model">mcct.site.report</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_mcct_site_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun rapport de chantier</p>
            <p>Notez chaque jour l'effectif, la météo, les travaux réalisés et ajoutez des photos.
               Publiez le rapport pour que le client le voie sur son portail.</p>
        </field>
    </record>

</odoo>
