<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcct_industry.ChantierMap">
        <div class="o_action o_mcct_map_action">
            <ControlPanel>
                <t t-set-slot="control-panel-always-buttons">
                    <div class="btn-group" role="group" aria-label="Chantiers affichés">
                        <t t-foreach="scopes" t-as="scope" t-key="scope.key">
                            <button type="button" class="btn"
                                    t-att-class="state.scope === scope.key ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setScope(scope.key)"
                                    t-esc="scope.label"/>
                        </t>
                    </div>
                </t>
            </ControlPanel>

            <div class="o_content o_mcct_map" t-if="state.data">
                <div class="o_mcct_map_canvas">
                    <svg t-ref="svg" t-att-viewBox="viewBox" preserveAspectRatio="xMidYMid meet"
                         role="img" aria-label="Carte du Maroc avec les chantiers"
                         class="o_mcct_map_svg"
                         t-on-wheel="onWheel" t-on-pointerdown="onPointerDown"
                         t-on-pointermove="onPointerMove" t-on-pointerup="onPointerUp"
                         t-on-pointerleave="onPointerUp">
                        <path class="o_mcct_land" t-att-d="outline"
                              t-att-stroke-width="1.2 * unit"/>
                        <t t-set="mapLayout" t-value="layout"/>
                        <g class="o_mcct_landmarks">
                            <t t-foreach="mapLayout.landmarks" t-as="landmark" t-key="landmark.name">
                                <circle t-att-cx="landmark.x" t-att-cy="landmark.y" t-att-r="2.2 * unit"/>
                                <text t-att-x="landmark.x + 5 * unit" t-att-y="landmark.y"
                                      t-att-font-size="10 * unit" dy="0.35em" t-esc="landmark.name"/>
                            </t>
                        </g>
                        <g class="o_mcct_markers">
                            <t t-foreach="mapLayout.markers" t-as="marker" t-key="marker.key">
                                <g t-att-class="markerClass(marker)" t-on-click="() => this.onMarkerClick(marker)">
                                    <title t-esc="markerTitle(marker)"/>
                                    <circle t-att-cx="marker.x" t-att-cy="marker.y" t-att-r="marker.r"
                                            t-att-stroke-width="(marker.selected ? 3 : 1.5) * unit"/>
                                    <text class="o_mcct_marker_count" t-att-x="marker.x" t-att-y="marker.y"
                                          t-att-font-size="11 * unit" dy="0.35em" text-anchor="middle"
                                          t-esc="marker.count"/>
                                    <text t-if="marker.labelSide" class="o_mcct_marker_label"
                                          t-att-x="marker.labelSide === 'start' ? marker.x + marker.r + 4 * unit : marker.x - marker.r - 4 * unit"
                                          t-att-y="marker.y" t-att-text-anchor="marker.labelSide"
                                          t-att-font-size="12 * unit" t-att-stroke-width="3 * unit"
                                          dy="0.35em" t-esc="marker.name"/>
                                </g>
                            </t>
                        </g>
                    </svg>
                    <div class="o_mcct_map_zoom btn-group-vertical">
                        <button type="button" class="btn btn-light border" title="Zoom avant"
                                t-on-click="() => this.zoom(0.66)"><i class="fa fa-plus"/></button>
                        <button type="button" class="btn btn-light border" title="Zoom arrière"
                                t-on-click="() => this.zoom(1.5)"><i class="fa fa-minus"/></button>
                        <button type="button" class="btn btn-light border" title="Tout le Maroc"
                                t-on-click="resetView"><i class="fa fa-arrows-alt"/></button>
                    </div>
                    <div class="o_mcct_map_legend small">
                        <span><i class="o_mcct_dot"/> En cours</span>
                        <span><i class="o_mcct_dot o_mcct_dot--late"/> En retard</span>
                        <span><i class="o_mcct_dot o_mcct_dot--received"/> Réceptionné</span>
                    </div>
                </div>

                <aside class="o_mcct_map_side">
                    <div class="o_mcct_map_kpis">
                        <div><strong t-esc="state.data.totals.count"/><span>chantiers</span></div>
                        <div><strong t-esc="state.data.totals.cities"/><span>villes</span></div>
                        <div><strong t-esc="state.data.totals.equipment"/><span>engins &amp; matériels</span></div>
                        <div t-att-class="{'text-danger': state.data.totals.late}">
                            <strong t-esc="state.data.totals.late"/><span>en retard</span>
                        </div>
                    </div>
                    <div class="o_mcct_map_total text-muted small mb-3">
                        Marchés HT : <strong t-esc="formatAmount(state.data.totals.amount)"/>
                    </div>

                    <t t-set="city" t-value="selectedCity"/>
                    <t t-if="city">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h4 class="mb-0"><i class="fa fa-map-marker me-2 text-primary"/><t t-esc="city.name"/></h4>
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.selectCity(city.key)">
                                Toutes les villes
                            </button>
                        </div>
                        <t t-foreach="city.projects" t-as="item" t-key="item.id">
                            <t t-call="mcct_industry.ChantierMap.Card"/>
                        </t>
                    </t>
                    <t t-else="">
                        <h5 class="mb-2">Villes</h5>
                        <div t-if="!state.data.cities.length" class="text-muted">
                            Aucun chantier localisé. Renseignez la ville du chantier (onglet « Chantier »).
                        </div>
                        <div class="list-group mb-3">
                            <t t-foreach="state.data.cities" t-as="entry" t-key="entry.key">
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                        t-on-click="() => this.selectCity(entry.key)">
                                    <span class="o_mcct_dot" t-att-class="{'o_mcct_dot--late': entry.late, 'o_mcct_dot--received': entry.received and !entry.late}"/>
                                    <span class="flex-grow-1 text-start">
                                        <strong t-esc="entry.name"/>
                                        <span class="text-muted small d-block">
                                            <t t-esc="plural(entry.count, 'chantier', 'chantiers')"/>
                                            <t t-if="entry.equipment_count"> · <t t-esc="plural(entry.equipment_count, 'matériel', 'matériels')"/></t>
                                        </span>
                                    </span>
                                    <span class="small text-nowrap" t-esc="formatAmount(entry.amount)"/>
                                </button>
                            </t>
                        </div>
                    </t>

                    <div t-if="state.data.unlocated.length" class="o_mcct_unlocated mt-3">
                        <h6 class="text-warning">
                            <i class="fa fa-question-circle me-1"/>
                            Non localisés (<t t-esc="state.data.unlocated.length"/>)
                        </h6>
                        <p class="small text-muted mb-2">
                            Ville absente ou non reconnue : corrigez-la ou saisissez les coordonnées GPS du chantier.
                        </p>
                        <t t-foreach="state.data.unlocated" t-as="item" t-key="item.id">
                            <t t-call="mcct_industry.ChantierMap.Card"/>
                        </t>
                    </div>
                </aside>
            </div>
        </div>
    </t>

    <t t-name="mcct_industry.ChantierMap.Card">
        <div class="card o_mcct_map_card mb-2" t-on-click="() => this.openProject(item.id)" role="button">
            <div class="card-body p-2">
                <div class="d-flex justify-content-between gap-2">
                    <strong class="text-truncate" t-esc="item.name" t-att-title="item.name"/>
                    <span t-if="item.late" class="badge text-bg-danger">En retard</span>
                </div>
                <div class="small text-muted text-truncate">
                    <t t-esc="item.partner"/><t t-if="item.city"> · <t t-esc="item.city"/></t>
                </div>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="badge rounded-pill"
                          t-att-class="item.received ? 'text-bg-success' : 'text-bg-info'"
                          t-esc="item.phase_label"/>
                    <div class="progress flex-grow-1" style="height: 6px;">
                        <div class="progress-bar" t-att-style="'width: ' + Math.min(item.progress, 100) + '%'"/>
                    </div>
                    <span class="small" t-esc="formatProgress(item.progress)"/>
                </div>
                <div class="d-flex justify-content-between small mt-1">
                    <span t-esc="formatAmount(item.amount)"/>
                    <span t-if="item.equipment_count" class="text-muted">
                        <i class="fa fa-truck me-1"/><t t-esc="item.equipment_count"/>
                    </span>
                </div>
            </div>
        </div>
    </t>

</templates>
