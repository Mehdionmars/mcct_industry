    <record id="product_beton_m3" model="product.template">
        <field name="name">Béton armé pour massifs et fondations</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_cubic_meter"/>
