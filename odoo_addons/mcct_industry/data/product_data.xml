<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="product_category_ouvrages" model="product.category">
        <field name="name">Ouvrages chantier</field>
    </record>

    <!--
        Catalogue d'ouvrages facturés au mètre (m, m², m³), au kilo ou au forfait.
        À la confirmation d'un devis, Odoo crée automatiquement le chantier.
        Les prix sont à renseigner par l'entreprise.
    -->
    <record id="product_etude" model="product.template">
        <field name="name">Étude et plans d'exécution</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom_forfait"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
        <field name="description_sale">Note de calcul, plans d'ensemble et plans d'atelier.</field>
    </record>

    <record id="product_charpente_kg" model="product.template">
        <field name="name">Charpente métallique — fourniture, fabrication et montage</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
        <field name="description_sale">Acier S235/S355, assemblages boulonnés et soudés, y compris peinture primaire.</field>
    </record>

    <record id="product_bardage_m2" model="product.template">
        <field name="name">Bardage métallique</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_square_meter"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
    </record>

    <record id="product_couverture_m2" model="product.template">
        <field name="name">Couverture bac acier</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_square_meter"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
    </record>

    <record id="product_tuyauterie_ml" model="product.template">
        <field name="name">Tuyauterie acier — préfabrication et montage (mètre linéaire)</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_meter"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
    </record>

    <record id="product_garde_corps_ml" model="product.template">
        <field name="name">Garde-corps et main courante (mètre linéaire)</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_ouvrages"/>
        <field name="uom_id" ref="uom.product_uom_meter"/>
        <field name="invoice_policy">delivery</field>
        <field name="service_type">manual</field>
        <field name="service_tracking">project_only</field>
